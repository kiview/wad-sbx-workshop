#!/usr/bin/env bash
# SANDBOX: start or refresh the visible app after agents change source/migrations.
set -euo pipefail
cd "$HOME/work/app"
state="$HOME/work/factory"
mkdir -p "$state/evidence"
if [ -f "$state/board.pid" ]; then
  pid="$(cat "$state/board.pid")"
  if kill -0 "$pid" 2>/dev/null; then kill "$pid"; fi
fi
./scripts/db-up.sh
export DATABASE_URL=postgres://board:board@127.0.0.1:55432/board
npm run db:migrate
# Seed once: refreshing the board must not wipe the learner's data.
if [ ! -f "$state/seeded" ]; then npm run db:seed; touch "$state/seeded"; fi
PORT=8080 HOST=0.0.0.0 nohup node --import tsx src/server.ts > "$state/evidence/board.log" 2>&1 &
printf '%s\n' "$!" > "$state/board.pid"
for _ in $(seq 1 40); do curl -fsS http://127.0.0.1:8080/healthz && exit 0; sleep 1; done
exit 1
