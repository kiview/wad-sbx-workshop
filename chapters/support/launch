#!/usr/bin/env bash
# HOST: one task, one environment, one sandbox. No task supervisor or acceptance engine.
set -euo pipefail
chapter="${1:?chapter directory}"; shift
root="$(cd "$(dirname "$0")/../.." && pwd)"
source "$chapter/chapter.env"
name="${1:-wad-ch-${CHAPTER//./-}}"
[[ "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]+$ ]] || { echo 'Use an alphanumeric sandbox name'; exit 2; }
control="$root/.local/chapters"
# Optional second argument is a learner's committed app; otherwise use the chapter fixture.
app="${2:-${WORKSHOP_APP_REPO:-$root/.local/app}}"
if [ "$chapter" = "$root/factory" ] && [ $# -lt 2 ]; then
  app="$root/sample-app"
  WORKSHOP_APP_REF=HEAD
fi
app_ref="${WORKSHOP_APP_REF:-$APP_REF}"
[ $# -lt 2 ] || app_ref=HEAD
[ -x "$control/bin/beans" ] || { echo 'Run scripts/install-beans.sh and scripts/backlog-init.sh --disposable first'; exit 2; }
record="$control/runs/$name"
[ ! -e "$record" ] || { echo 'Choose a fresh name; this run is preserved.'; exit 2; }
mkdir -p "$record/payload/app" "$record/payload/bin" "$record/payload/roles"
git -C "$app" archive "$app_ref" | tar xf - -C "$record/payload/app"
# Copy only workshop support and this chapter; no host backlog or credential files.
COPYFILE_DISABLE=1 tar --no-xattrs -cf - -C "$root/chapters/support" bin roles | tar xf - -C "$record/payload"
COPYFILE_DISABLE=1 tar --no-xattrs -cf - -C "$chapter" chapter.env PROMPT.md $(test ! -f "$chapter/team.tsv" || echo team.tsv) | tar xf - -C "$record/payload"
if [ "$MODE" = mcp ] || [ "$MODE" = human ]; then
  printf '%s\n' "$TASK" > "$record/payload/task-id"
else
  "$control/bin/beans" --config "$control/beans/.beans.yml" --beans-path "$control/beans/.beans" show --json "$TASK" > "$record/payload/task.json"
fi
if [ -n "${WORKSHOP_TEAM:-}" ]; then cat "$WORKSHOP_TEAM" > "$record/payload/team.tsv"; fi
if [ -n "${WORKSHOP_BASE_KIT:-}" ]; then
  sbx create "$WORKSHOP_BASE_KIT" --name "$name" --cpus 4 --memory 8g --skills off \
    --kit 'git+https://github.com/shelajev/acr-sbx-kit.git#ref=f446b95bccabd879912db174c190ff09377b7c7b' \
    --kit "$root/chapters/kits/pi" --kit "$root/chapters/kits/herdr" --publish "${WORKSHOP_PORT:-$PORT}:8080"
else
  sbx env create "$chapter/sbxenv.yaml" --env-arg "name=$name" --auto-approve
fi
COPYFILE_DISABLE=1 tar --no-xattrs -cf "$record/payload.tar" -C "$record/payload" .
want="$(shasum -a 256 "$record/payload.tar" | awk '{print $1}')"
sbx exec -i "$name" bash -lc 'cat > "$HOME/chapter.tar"' < "$record/payload.tar"
sbx exec "$name" bash -lc "echo '$want  '\"\$HOME/chapter.tar\" | sha256sum -c - && mkdir -p \"\$HOME/work\" && tar xf \"\$HOME/chapter.tar\" -C \"\$HOME/work\" && bash \"\$HOME/work/bin/prepare\""
printf '\nSource ready. Ask the agent to set up and run the project.\n'
printf 'Sandbox: %s\n' "$name"
printf 'Inspect: sbx exec -it %s bash\n' "$name"
printf "Keep this terminal open while working; use a second host terminal. Ctrl-C ends this session.\n"
exec sbx exec "$name" sleep infinity
