#!/usr/bin/env bash
# HOST: mount the project, deliver workshop tools and open the learner's session.
set -euo pipefail
chapter="$(cd "${1:?configuration directory}" && pwd)"; shift
root="$(cd "$(dirname "$0")/../.." && pwd)"
source "$chapter/chapter.env"
name="${1:?sandbox name}"; shift
app="$(cd "${1:-$root/sample-app}" && pwd)"
control="$root/.local/chapters"
[ -d "$app/.git" ] || git -C "$app" rev-parse --git-dir >/dev/null
[ -x "$control/bin/beans" ] || { echo 'First run scripts/install-beans.sh and scripts/backlog-init.sh --disposable'; exit 2; }
# Only support files are transferred. The project itself is mounted by SBX.
payload="$(mktemp -d)"
trap 'rm -rf "$payload"' EXIT
mkdir -p "$payload/bin" "$payload/roles"
COPYFILE_DISABLE=1 tar --no-xattrs -cf - -C "$root/chapters/support" bin roles | tar xf - -C "$payload"
cp "$chapter/chapter.env" "$chapter/PROMPT.md" "$payload/"
[ ! -f "$chapter/team.tsv" ] || cp "$chapter/team.tsv" "$payload/"
printf '%s\n' "$app" > "$payload/app-path"
if [ "$MODE" = mcp ]; then
  printf '%s\n' "$TASK" > "$payload/task-id"
else
  "$root/scripts/beans" show --json "$TASK" > "$payload/task.json"
fi
if [ -n "${WORKSHOP_BASE_KIT:-}" ]; then
  cp "$WORKSHOP_TEAM" "$payload/team.tsv"
  creation_options=(--publish 3102:8080)
  if [ "$MODE" = mcp ]; then
    sbx mcp add "$name-beans" --command "$root/scripts/beans-mcp" --args=--allow-notes
    creation_options+=(--static-mcp "$name-beans")
  fi
  sbx create "$WORKSHOP_BASE_KIT" "$app" --name "$name" --cpus 4 --memory 8g --skills off \
    --kit 'git+https://github.com/shelajev/acr-sbx-kit.git#ref=f446b95bccabd879912db174c190ff09377b7c7b' \
    --kit "$root/chapters/kits/pi" --kit "$root/chapters/kits/herdr" "${creation_options[@]}"
else
  sbx env create "$chapter/sbxenv.yaml" --env-arg "name=$name" --env-arg "app=$app" --auto-approve
fi
COPYFILE_DISABLE=1 tar --no-xattrs -cf "$payload.tar" -C "$payload" .
trap 'rm -rf "$payload"; rm -f "$payload.tar"' EXIT
sbx exec -i "$name" bash -lc 'mkdir -p "$HOME/work"; tar xf - -C "$HOME/work"' < "$payload.tar"
sbx exec "$name" bash -lc 'bash "$HOME/work/bin/prepare"'
printf '\nProject mounted: %s\nOpening your SANDBOX terminal. Keep it open while working.\n' "$app"
rm -rf "$payload"; rm -f "$payload.tar"; trap - EXIT
if [ "${SESSION:-claude}" = shell ]; then
  exec sbx exec -it -w "$app" "$name" bash --rcfile /home/agent/work/bin/shell-init -i
else
  exec sbx run --name "$name"
fi
